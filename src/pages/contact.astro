---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contact | Pratheek Prakash Shetty"
  description="Contact Pratheek Prakash Shetty for research conversations, collaboration, and professional inquiries."
>
  <div class="wrap page-shell contact-page">
    <header class="page-intro">
      <p class="section-eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p>For research conversations, collaboration, and professional inquiries, email is the best place to start.</p>
    </header>

    <section class="contact-panel" aria-labelledby="contact-options-title">
      <div>
        <h2 id="contact-options-title">Contact & profiles</h2>
        {site.email ? (
          <p class="contact-email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        ) : (
          <p class="todo-note">TODO: Add a public email address in src/data/site.ts.</p>
        )}
      </div>
      <div>
        <SocialLinks includeEmail includeBlog />
        {!site.profiles.github && !site.profiles.scholar && !site.profiles.linkedin && (
          <p class="todo-note">TODO: Add verified GitHub, Google Scholar, and LinkedIn URLs in src/data/site.ts.</p>
        )}
      </div>
    </section>

    <p class="privacy-note">This static site intentionally does not use a contact form, analytics script, or third-party tracker.</p>
  </div>
</BaseLayout>
