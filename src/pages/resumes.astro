---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeCard from "../components/ResumeCard.astro";
import { resumes } from "../data/resumes";
---

<BaseLayout
  title="Resumes | Pratheek Prakash Shetty"
  description="Academic CV and focused resumes for GPU systems, compiler and ML systems, and software engineering."
>
  <div class="wrap page-shell">
    <header class="page-intro">
      <p class="section-eyebrow">Documents</p>
      <h1>Resumes & CV</h1>
      <p>I maintain several versions of my resume highlighting different aspects of my work. Choose the one most relevant to your context.</p>
    </header>

    <section class="resume-page-grid" aria-label="Resume options">
      {resumes.map((resume) => <ResumeCard resume={resume} />)}
    </section>

    
  </div>
</BaseLayout>
