---
import type { ResumeEntry } from "../data/types";
import { withBase } from "../data/site";

interface Props {
  resume: ResumeEntry;
  compact?: boolean;
}

const { resume, compact = false } = Astro.props;
const fileUrl = withBase(resume.file);
---

<article class:list={["resume-card", { compact }]}>
  <p class="resume-type">{resume.category}</p>
  <h3>{resume.name}</h3>
  <p>{resume.description}</p>
  {
    resume.available ? (
      <div class="resume-actions">
        <a href={fileUrl} target="_blank" rel="noreferrer" aria-label={`${resume.viewLabel}: ${resume.name}`}>
          {resume.viewLabel} <span aria-hidden="true">↗</span>
        </a>
        {!compact && (
          <a href={fileUrl} download aria-label={`Download ${resume.name} PDF`}>
            Download PDF <span aria-hidden="true">↓</span>
          </a>
        )}
      </div>
    ) : (
      <p class="file-note"><span aria-hidden="true">○</span> PDF pending — expected at <code>{resume.file}</code></p>
    )
  }
</article>
